APP_NAME=Maw3idy
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://maw3idy.localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Central domain serves landing + registration; each tenant lives on {slug}.APP_CENTRAL_DOMAIN.
# *.localhost resolves to 127.0.0.1 in every modern browser with no hosts-file entry, so
# `php artisan serve` + http://demo.maw3idy.localhost:8000 just works. A custom domain such
# as maw3idy.test needs a hosts entry per subdomain (hosts files have no wildcards).
APP_CENTRAL_DOMAIN=maw3idy.localhost

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maw3idy
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Deliberately host-only (null): a session cookie set on one tenant's subdomain is never
# sent to another tenant's subdomain, so sessions cannot leak across tenants.
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# "log" writes mail to storage/logs; point at Mailpit (127.0.0.1:1025, MAIL_MAILER=smtp) if you run one
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@maw3idy.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
